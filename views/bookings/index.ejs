<%- layout('/layouts/boilerplate') -%>

<div class="container my-4">
  <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">My Trips & Bookings</h2>
      <p class="text-muted small mb-0">Track your reservation requests, confirmed stays, and trip history.</p>
    </div>
    <a href="/listing" class="btn btn-outline-danger btn-sm rounded-pill px-3">
      <i class="fa-solid fa-magnifying-glass me-1"></i> Explore More Stays
    </a>
  </div>

  <% if(bookings && bookings.length > 0) { %>
    <div class="row g-4">
      <% for(let booking of bookings) { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card booking-card h-100 border rounded-4 overflow-hidden shadow-xs">
            <!-- Property Image & Status Ribbon -->
            <div class="position-relative">
              <a href="/listing/<%= booking.listing ? booking.listing._id : '' %>">
                <img 
                  src="<%= booking.listing && booking.listing.image && booking.listing.image.url ? booking.listing.image.url : '/defaulttravelimg.jpg' %>" 
                  class="card-img-top booking-card-img" 
                  alt="<%= booking.listing ? booking.listing.title : 'Property' %>"
                />
              </a>
              <div class="booking-status-badge position-absolute top-0 end-0 m-3">
                <% if(booking.status === 'pending') { %>
                  <span class="badge bg-warning text-dark shadow-sm px-3 py-2 rounded-pill">
                    <i class="fa-regular fa-clock me-1"></i> Pending Host Approval
                  </span>
                <% } else if(booking.status === 'confirmed') { %>
                  <span class="badge bg-success shadow-sm px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-circle-check me-1"></i> Confirmed Stay
                  </span>
                <% } else if(booking.status === 'rejected') { %>
                  <span class="badge bg-danger shadow-sm px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-circle-xmark me-1"></i> Declined
                  </span>
                <% } else if(booking.status === 'cancelled') { %>
                  <span class="badge bg-secondary shadow-sm px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-ban me-1"></i> Cancelled
                  </span>
                <% } %>
              </div>
            </div>

            <!-- Booking Info -->
            <div class="card-body p-3 d-flex flex-column justify-content-between">
              <div>
                <h5 class="fw-bold mb-1 text-truncate">
                  <%= booking.listing ? booking.listing.title : "Unknown Property" %>
                </h5>
                <p class="text-muted small mb-2">
                  <i class="fa-solid fa-location-dot text-danger me-1"></i>
                  <%= booking.listing ? booking.listing.location + ', ' + booking.listing.country : 'Location not available' %>
                </p>

                <div class="bg-light p-2 rounded-3 small mb-3">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Dates:</span>
                    <span class="fw-semibold">
                      <%= new Date(booking.checkIn).toLocaleDateString() %> — <%= new Date(booking.checkOut).toLocaleDateString() %>
                    </span>
                  </div>
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Duration:</span>
                    <span class="fw-semibold"><%= booking.nights %> <%= booking.nights === 1 ? 'night' : 'nights' %></span>
                  </div>
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Guests:</span>
                    <span class="fw-semibold"><%= booking.guestsCount %> <%= booking.guestsCount === 1 ? 'guest' : 'guests' %></span>
                  </div>
                  <div class="d-flex justify-content-between pt-1 border-top">
                    <span class="text-muted">Total Cost:</span>
                    <span class="fw-bold text-danger fs-6">$ <%= booking.totalPrice ? booking.totalPrice.toLocaleString('en-US') : '0' %></span>
                  </div>
                </div>

                <% if(booking.guestMessage) { %>
                  <p class="text-muted small fst-italic mb-2">
                    "<%= booking.guestMessage %>"
                  </p>
                <% } %>
              </div>

              <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                <a href="/listing/<%= booking.listing ? booking.listing._id : '' %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                  View Property
                </a>

                <% if(booking.status === 'pending') { %>
                  <form method="POST" action="/bookings/<%= booking._id %>/cancel" onsubmit="return confirm('Cancel this booking request?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                      Cancel Request
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="text-center py-5">
      <div class="mb-3">
        <i class="fa-solid fa-suitcase-rolling fa-4x text-muted opacity-50"></i>
      </div>
      <h4 class="fw-bold">No trips booked... yet!</h4>
      <p class="text-muted max-w-md mx-auto">
        Time to dust off your bags and start planning your next getaway. Explore properties across beaches, mountains, and iconic cities.
      </p>
      <a href="/listing" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold mt-2">
        Start Exploring Stays
      </a>
    </div>
  <% } %>
</div>
