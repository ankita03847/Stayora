<% if(success && success.length) { %>

<div class="position-fixed p-3" style="top: 80px; right: 20px; z-index: 1080;">

<div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="min-width: 250px; max-width: 320px;">

   <%= success %>

<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

</div></div>

<%}%>


<% if(error && error.length) { %>

<div class="position-fixed p-3" style="top: 80px; right: 20px; z-index: 1080;">

<div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="min-width: 250px; max-width: 320px;">

   
   <%= error %>

<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

</div></div>

<%}%>