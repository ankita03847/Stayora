<%- layout('/layouts/boilerplate') -%>

<div class="container my-4">
  <!-- Title & Location Header -->
  <div class="mb-3">
    <h2 class="fw-bold mb-1"><%= listing.title %></h2>
    <div class="d-flex align-items-center gap-3 text-muted small">
      <span><i class="fa-solid fa-star text-danger"></i> 4.85 · <%= listing.reviews ? listing.reviews.length : 0 %> reviews</span>
      <span>·</span>
      <span><i class="fa-solid fa-location-dot text-danger"></i> <%= listing.location %>, <%= listing.country %></span>
      <span>·</span>
      <span class="badge bg-light text-dark border"><%= listing.category || 'Beach' %></span>
    </div>
  </div>

  <!-- Showcase Image Banner -->
  <div class="mb-4 property-hero-container">
    <img 
      src="<%= listing.image && listing.image.url ? listing.image.url : '/defaulttravelimg.jpg' %>" 
      class="img-fluid w-100 property-hero-img" 
      alt="<%= listing.title %>"
    />
  </div>

  <!-- Two-Column Layout: Details on Left, Booking Box on Right -->
  <div class="row g-5">
    <!-- Left Column (7 cols): Property Information, Amenities & Reviews -->
    <div class="col-lg-7">
      <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-4">
        <div>
          <h4 class="fw-bold mb-1">Hosted by <%= listing.owner ? listing.owner.username : "Stayora Host" %></h4>
          <p class="text-muted small mb-0">Up to <%= listing.maxGuests || 4 %> guests · Private property</p>
        </div>
        <div class="user-avatar-circle" style="width: 48px; height: 48px; font-size: 1.2rem;">
          <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : "H" %>
        </div>
      </div>

      <!-- Description -->
      <div class="mb-4">
        <h5 class="fw-bold mb-2">About this space</h5>
        <p class="text-secondary leading-relaxed" style="white-space: pre-line;"><%= listing.description %></p>
      </div>

      <hr class="my-4">

      <!-- Owner Quick Actions -->
      <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
        <div class="alert alert-light border d-flex align-items-center justify-content-between p-3 mb-4">
          <div>
            <strong>You are the host of this listing</strong>
            <div class="text-muted small">Manage reservations or update property details</div>
          </div>
          <div class="d-flex gap-2">
            <a href="/listing/<%= listing._id %>/edit" class="btn btn-outline-secondary btn-sm">Edit Listing</a>
            <form method="POST" action="/listing/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing?')">
              <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
            </form>
          </div>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="mt-4">
        <div class="d-flex align-items-center gap-2 mb-3">
          <h4 class="fw-bold mb-0">Guest Reviews</h4>
          <span class="badge bg-light text-dark border">
            ⭐ 4.85 (<%= listing.reviews ? listing.reviews.length : 0 %>)
          </span>
        </div>

        <% if(listing.reviews && listing.reviews.length > 0) { %>
          <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
            <% for(review of listing.reviews){ %>
              <div class="col">
                <div class="review-card h-100 p-3 border rounded-3 bg-white shadow-xs">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="review-avatar">
                        <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : "G" %>
                      </div>
                      <div>
                        <div class="fw-bold small"><%= review.author ? review.author.username : "Guest" %></div>
                        <div class="text-muted" style="font-size: 0.75rem;"><%= new Date(review.createdAt).toLocaleDateString() %></div>
                      </div>
                    </div>
                    <span class="text-warning small">
                      <% for(let i = 1; i <= 5; i++){ %>
                        <% if(i <= review.rating){ %>★<% } else { %>☆<% } %>
                      <% } %>
                    </span>
                  </div>
                  <p class="text-secondary small mb-2"><%= review.comment %></p>
                  <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
                    <form method="POST" action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button type="submit" class="btn btn-link text-danger p-0 small text-decoration-none" style="font-size: 0.75rem;">Delete review</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-4">No reviews yet for this stay. Be the first guest to share your experience!</p>
        <% } %>

        <!-- Leave a Review Form -->
        <% if(currUser) { %>
          <div class="border rounded-3 p-3 bg-light">
            <h6 class="fw-bold mb-2">Leave a Review</h6>
            <form action="/listing/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
              <div class="mb-2">
                <label class="form-label small fw-semibold">Rating</label>
                <div class="star-rating justify-content-start">
                  <input type="radio" id="star5" name="review[rating]" value="5" required>
                  <label for="star5" title="5 stars">★</label>
                  <input type="radio" id="star4" name="review[rating]" value="4">
                  <label for="star4" title="4 stars">★</label>
                  <input type="radio" id="star3" name="review[rating]" value="3">
                  <label for="star3" title="3 stars">★</label>
                  <input type="radio" id="star2" name="review[rating]" value="2">
                  <label for="star2" title="2 stars">★</label>
                  <input type="radio" id="star1" name="review[rating]" value="1">
                  <label for="star1" title="1 star">★</label>
                </div>
              </div>
              <div class="mb-3">
                <textarea name="review[comment]" rows="3" class="form-control form-control-sm" placeholder="How was your stay?" required></textarea>
                <div class="invalid-feedback">Please write a short review comment.</div>
              </div>
              <button class="btn btn-dark btn-sm rounded-pill px-3" type="submit">Submit Review</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column (5 cols): Stayora Sticky Booking Widget -->
    <div class="col-lg-5">
      <div class="booking-widget-card sticky-top border rounded-4 p-4 shadow-sm bg-white" style="top: 100px;">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
          <div>
            <span class="fs-3 fw-bold text-dark">$ <%= listing.price ? listing.price.toLocaleString("en-US") : "0" %></span>
            <span class="text-muted"> / night</span>
          </div>
          <div class="text-muted small">
            ⭐ 4.85 (<%= listing.reviews ? listing.reviews.length : 0 %>)
          </div>
        </div>

        <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
          <!-- Host Perspective -->
          <div class="alert alert-info border-0 rounded-3 text-center my-3">
            <i class="fa-solid fa-house-user fs-4 mb-2 d-block text-primary"></i>
            <strong>This is your property</strong>
            <p class="small mb-3 mt-1">Guests can submit reservation requests for these dates.</p>
            <a href="/dashboard" class="btn btn-primary btn-sm rounded-pill px-3 w-100">
              Go to Owner Dashboard
            </a>
          </div>
        <% } else { %>
          <!-- Guest Booking Request Form -->
          <form action="/listing/<%= listing._id %>/book" method="POST" class="needs-validation" novalidate id="bookingForm">
            <!-- Date Pickers Grid -->
            <div class="booking-dates-box border rounded-3 p-2 mb-3">
              <div class="row g-2">
                <div class="col-6 border-end">
                  <label for="checkIn" class="booking-box-label">CHECK-IN</label>
                  <input 
                    type="date" 
                    id="checkIn" 
                    name="checkIn" 
                    class="form-control form-control-sm border-0 p-0 fw-semibold" 
                    required
                  >
                </div>
                <div class="col-6">
                  <label for="checkOut" class="booking-box-label">CHECKOUT</label>
                  <input 
                    type="date" 
                    id="checkOut" 
                    name="checkOut" 
                    class="form-control form-control-sm border-0 p-0 fw-semibold" 
                    required
                  >
                </div>
              </div>
            </div>

            <!-- Guests Dropdown -->
            <div class="mb-3">
              <label for="guestsCount" class="booking-box-label">GUESTS</label>
              <select name="guestsCount" id="guestsCount" class="form-select form-select-sm">
                <% for(let g = 1; g <= (listing.maxGuests || 4); g++) { %>
                  <option value="<%= g %>"><%= g %> <%= g === 1 ? 'guest' : 'guests' %></option>
                <% } %>
              </select>
            </div>

            <!-- Optional message to host -->
            <div class="mb-3">
              <label for="guestMessage" class="booking-box-label">NOTE TO HOST (OPTIONAL)</label>
              <input 
                type="text" 
                name="guestMessage" 
                id="guestMessage" 
                class="form-control form-control-sm" 
                placeholder="E.g. Arriving around 3 PM"
              >
            </div>

            <% if(currUser) { %>
              <button type="submit" class="btn btn-danger w-100 py-2 rounded-3 fw-bold fs-6 shadow-sm mb-3">
                Request to Book
              </button>
              <p class="text-center text-muted small mb-3">You won't be charged yet</p>
            <% } else { %>
              <a href="/loginUser" class="btn btn-danger w-100 py-2 rounded-3 fw-bold fs-6 shadow-sm mb-3">
                Log In to Request Booking
              </a>
              <p class="text-center text-muted small mb-3">Sign in or create an account to book this stay</p>
            <% } %>

            <!-- Dynamic Price Breakdown -->
            <div id="priceBreakdown" class="border-top pt-3 small" style="display: none;">
              <div class="d-flex justify-content-between mb-2 text-muted">
                <span>$ <span id="ratePerNight"><%= listing.price || 0 %></span> x <span id="numNights">0</span> nights</span>
                <span>$ <span id="baseTotal">0</span></span>
              </div>
              <div class="d-flex justify-content-between mb-2 text-muted">
                <span>Stayora service fee (10%)</span>
                <span>$ <span id="serviceFee">0</span></span>
              </div>
              <div class="d-flex justify-content-between fw-bold text-dark pt-2 border-top">
                <span>Total before taxes</span>
                <span>$ <span id="grandTotal">0</span></span>
              </div>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Real-time Price Calculation Script -->
<script>
  (function() {
    const checkInInput = document.getElementById('checkIn');
    const checkOutInput = document.getElementById('checkOut');
    const priceBreakdown = document.getElementById('priceBreakdown');
    const rate = <%= listing.price || 0 %>;

    // Set today as minimum check-in date
    const today = new Date().toISOString().split('T')[0];
    if (checkInInput) checkInInput.min = today;

    function updatePrice() {
      if (!checkInInput || !checkOutInput) return;
      const start = new Date(checkInInput.value);
      const end = new Date(checkOutInput.value);

      if (checkInInput.value && checkOutInput.value && end > start) {
        const diffTime = end.getTime() - start.getTime();
        const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        const base = nights * rate;
        const fee = Math.round(base * 0.10);
        const total = base + fee;

        document.getElementById('numNights').innerText = nights;
        document.getElementById('baseTotal').innerText = base.toLocaleString('en-US');
        document.getElementById('serviceFee').innerText = fee.toLocaleString('en-US');
        document.getElementById('grandTotal').innerText = total.toLocaleString('en-US');
        priceBreakdown.style.display = 'block';
      } else {
        if (priceBreakdown) priceBreakdown.style.display = 'none';
      }
    }

    if (checkInInput && checkOutInput) {
      checkInInput.addEventListener('change', function() {
        checkOutInput.min = this.value;
        updatePrice();
      });
      checkOutInput.addEventListener('change', updatePrice);
    }
  })();
</script>
