<%- layout('/layouts/boilerplate') -%>

<div class="container my-4">
  <!-- Dashboard Header -->
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-3 border-bottom gap-3">
    <div>
      <h2 class="fw-bold mb-1">Host & Owner Dashboard</h2>
      <p class="text-muted small mb-0">Manage your properties, review reservation requests, and track your revenue.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/listing/new" class="btn btn-danger btn-sm rounded-pill px-3 py-2 fw-semibold">
        <i class="fa-solid fa-plus me-1"></i> List New Property
      </a>
      <a href="/listing" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2">
        <i class="fa-solid fa-eye me-1"></i> Explore Market
      </a>
    </div>
  </div>

  <!-- KPI Metrics Grid -->
  <div class="row g-3 mb-5">
    <!-- Total Properties -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card metric-card border rounded-4 p-3 shadow-xs h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-muted small fw-semibold">MY PROPERTIES</span>
          <div class="metric-icon-circle bg-primary-subtle text-primary">
            <i class="fa-solid fa-building"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0 text-dark"><%= totalProperties %></h3>
        <span class="text-muted small">Active listings</span>
      </div>
    </div>

    <!-- Pending Requests -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card metric-card border rounded-4 p-3 shadow-xs h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-muted small fw-semibold">PENDING REQUESTS</span>
          <div class="metric-icon-circle bg-warning-subtle text-warning">
            <i class="fa-solid fa-bell"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0 text-dark"><%= pendingRequests ? pendingRequests.length : 0 %></h3>
        <span class="text-muted small"><%= pendingRequests && pendingRequests.length > 0 ? 'Requires your decision' : 'All caught up' %></span>
      </div>
    </div>

    <!-- Confirmed Bookings -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card metric-card border rounded-4 p-3 shadow-xs h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-muted small fw-semibold">CONFIRMED STAYS</span>
          <div class="metric-icon-circle bg-success-subtle text-success">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0 text-dark"><%= confirmedBookings ? confirmedBookings.length : 0 %></h3>
        <span class="text-muted small">Total reservations</span>
      </div>
    </div>

    <!-- Estimated Revenue -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card metric-card border rounded-4 p-3 shadow-xs h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-muted small fw-semibold">TOTAL REVENUE</span>
          <div class="metric-icon-circle bg-danger-subtle text-danger">
            <i class="fa-solid fa-dollar-sign"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0 text-dark">$ <%= totalEarnings ? totalEarnings.toLocaleString('en-US') : '0' %></h3>
        <span class="text-muted small">From confirmed bookings</span>
      </div>
    </div>
  </div>

  <!-- Section 1: Pending Booking Requests (Requires Action) -->
  <div class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h4 class="fw-bold mb-0">
        Booking Requests
        <% if(pendingRequests && pendingRequests.length > 0) { %>
          <span class="badge bg-warning text-dark ms-2 rounded-pill"><%= pendingRequests.length %> Pending</span>
        <% } %>
      </h4>
    </div>

    <% if(pendingRequests && pendingRequests.length > 0) { %>
      <div class="table-responsive bg-white rounded-4 border shadow-xs">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-3 py-3">Property</th>
              <th scope="col">Guest</th>
              <th scope="col">Dates & Duration</th>
              <th scope="col">Guests</th>
              <th scope="col">Payout</th>
              <th scope="col">Message</th>
              <th scope="col" class="text-end pe-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for(let reqItem of pendingRequests) { %>
              <tr>
                <td class="ps-3">
                  <div class="d-flex align-items-center gap-2">
                    <img 
                      src="<%= reqItem.listing && reqItem.listing.image && reqItem.listing.image.url ? reqItem.listing.image.url : '/defaulttravelimg.jpg' %>" 
                      style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover;" 
                      alt=""
                    />
                    <div>
                      <div class="fw-bold small text-truncate" style="max-width: 180px;">
                        <%= reqItem.listing ? reqItem.listing.title : 'Property' %>
                      </div>
                      <div class="text-muted" style="font-size: 0.75rem;">
                        <%= reqItem.listing ? reqItem.listing.location : '' %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="fa-solid fa-user me-1"></i>
                    <%= reqItem.guest ? reqItem.guest.username : 'Guest' %>
                  </span>
                </td>
                <td>
                  <div class="small fw-semibold">
                    <%= new Date(reqItem.checkIn).toLocaleDateString() %> — <%= new Date(reqItem.checkOut).toLocaleDateString() %>
                  </div>
                  <div class="text-muted" style="font-size: 0.75rem;"><%= reqItem.nights %> nights</div>
                </td>
                <td>
                  <span class="small"><%= reqItem.guestsCount %> <%= reqItem.guestsCount === 1 ? 'guest' : 'guests' %></span>
                </td>
                <td>
                  <span class="fw-bold text-dark">$ <%= reqItem.totalPrice ? reqItem.totalPrice.toLocaleString('en-US') : '0' %></span>
                </td>
                <td>
                  <span class="text-muted small fst-italic text-truncate d-inline-block" style="max-width: 140px;">
                    <%= reqItem.guestMessage || 'No message' %>
                  </span>
                </td>
                <td class="text-end pe-3">
                  <div class="d-inline-flex gap-2">
                    <form method="POST" action="/bookings/<%= reqItem._id %>/accept">
                      <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-check me-1"></i> Accept
                      </button>
                    </form>
                    <form method="POST" action="/bookings/<%= reqItem._id %>/reject" onsubmit="return confirm('Decline this booking request?')">
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-xmark me-1"></i> Reject
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card border rounded-4 p-4 text-center bg-light">
        <i class="fa-solid fa-inbox fs-3 text-muted mb-2"></i>
        <h6 class="fw-bold mb-1">No pending booking requests</h6>
        <p class="text-muted small mb-0">When travelers request to stay at your properties, they will appear here for your review.</p>
      </div>
    <% } %>
  </div>

  <!-- Section 2: Confirmed Upcoming Stays -->
  <% if(confirmedBookings && confirmedBookings.length > 0) { %>
    <div class="mb-5">
      <h4 class="fw-bold mb-3">Confirmed Reservations</h4>
      <div class="row g-3">
        <% for(let conf of confirmedBookings) { %>
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card border rounded-4 p-3 bg-white shadow-xs">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                  <i class="fa-solid fa-circle-check me-1"></i> Confirmed
                </span>
                <span class="fw-bold text-dark">$ <%= conf.totalPrice ? conf.totalPrice.toLocaleString('en-US') : '0' %></span>
              </div>
              <h6 class="fw-bold mb-1 text-truncate">
                <%= conf.listing ? conf.listing.title : 'Property' %>
              </h6>
              <div class="small text-muted mb-2">
                Guest: <b><%= conf.guest ? conf.guest.username : 'Guest' %></b> (<%= conf.guestsCount %> guests)
              </div>
              <div class="bg-light p-2 rounded-3 small">
                <i class="fa-regular fa-calendar text-muted me-1"></i>
                <%= new Date(conf.checkIn).toLocaleDateString() %> to <%= new Date(conf.checkOut).toLocaleDateString() %> (<%= conf.nights %> nights)
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Section 3: My Listed Properties -->
  <div>
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h4 class="fw-bold mb-0">My Properties (<%= listings ? listings.length : 0 %>)</h4>
      <a href="/listing/new" class="btn btn-outline-danger btn-sm rounded-pill px-3">
        <i class="fa-solid fa-plus me-1"></i> Add Property
      </a>
    </div>

    <% if(listings && listings.length > 0) { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% for(let prop of listings) { %>
          <div class="col">
            <div class="card h-100 border rounded-4 overflow-hidden shadow-xs">
              <img 
                src="<%= prop.image && prop.image.url ? prop.image.url : '/defaulttravelimg.jpg' %>" 
                class="card-img-top" 
                style="height: 180px; object-fit: cover;" 
                alt="<%= prop.title %>"
              />
              <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div>
                  <h6 class="fw-bold mb-1 text-truncate"><%= prop.title %></h6>
                  <p class="text-muted small mb-2"><%= prop.location %>, <%= prop.country %></p>
                  <div class="fw-bold small text-dark mb-3">
                    $ <%= prop.price ? prop.price.toLocaleString('en-US') : '0' %> <span class="text-muted fw-normal">/ night</span>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-2 pt-2 border-top">
                  <a href="/listing/<%= prop._id %>" class="btn btn-sm btn-outline-secondary rounded-pill flex-grow-1">View</a>
                  <a href="/listing/<%= prop._id %>/edit" class="btn btn-sm btn-outline-primary rounded-pill flex-grow-1">Edit</a>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="card border rounded-4 p-5 text-center bg-light">
        <i class="fa-solid fa-house-chimney fs-2 text-muted mb-2"></i>
        <h5 class="fw-bold mb-1">You haven't listed any properties yet</h5>
        <p class="text-muted small mb-3">Start sharing your space on Stayora to accept bookings and earn revenue.</p>
        <div>
          <a href="/listing/new" class="btn btn-danger rounded-pill px-4">Create Your First Listing</a>
        </div>
      </div>
    <% } %>
  </div>
</div>
